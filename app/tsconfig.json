{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "moduleResolution": "bundler",
    "module": "ESNext"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
